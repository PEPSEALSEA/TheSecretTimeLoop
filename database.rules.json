{
  "rules": {
    "teams": {
      ".read": true,
      "$teamId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'score', 'startingScore', 'updatedAt']) && newData.child('score').isNumber() && newData.child('startingScore').isNumber() && newData.child('updatedAt').isNumber()"
      }
    },
    "game": {
      ".read": true,
      ".write": true
    },
    "presence": {
      ".read": true,
      "$sessionId": {
        ".write": true,
        ".validate": "newData.hasChildren(['at', 'path', 'role']) && newData.child('at').isNumber() && newData.child('path').isString() && newData.child('role').isString()"
      }
    }
  }
}
