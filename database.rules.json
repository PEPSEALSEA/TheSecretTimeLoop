{
  "rules": {
    "teams": {
      "$teamId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'score', 'startingScore', 'updatedAt']) && newData.child('score').isNumber() && newData.child('startingScore').isNumber() && newData.child('updatedAt').isNumber()"
      }
    }
  }
}
